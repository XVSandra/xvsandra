rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /vibedumpPhotos/{photoId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.eventId == "xv-sandra-alicia-2026"
                    && request.resource.data.status == "pending"
                    && request.resource.data.guestName is string
                    && request.resource.data.guestName.size() >= 2
                    && request.resource.data.guestName.size() <= 40
                    && request.resource.data.storagePath is string
                    && request.resource.data.downloadUrl is string
                    && request.resource.data.sizeBytes is int
                    && request.resource.data.sizeBytes < 15 * 1024 * 1024;

      allow read, update, delete: if false;
    }
  }
}
